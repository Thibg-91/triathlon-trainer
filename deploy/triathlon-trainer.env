# Configuration de Triathlon Trainer, copiée dans /etc/default/triathlon-trainer.
# Après modification : sudo systemctl restart triathlon-trainer

# Adresse d'écoute. 127.0.0.1 = accessible uniquement via Tailscale Serve (recommandé).
# 0.0.0.0 = accessible aussi depuis le réseau local en http://<ip-du-pi>:8000
TRI_HOST=127.0.0.1
TRI_PORT=8000

# Conservation des sauvegardes (jours)
TRI_BACKUP_KEEP_DAYS=30
